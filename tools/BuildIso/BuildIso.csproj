<Project Sdk="Microsoft.NET.Sdk">
  <!-- Outil de test : génère une ISO depuis le code courant, sans passer par l'interface.
       Usage : dotnet run, projet tools/BuildIso, arguments : iso_source iso_sortie
       (voir tools/README.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AndroidTvPcIsoBuilder.Infrastructure\AndroidTvPcIsoBuilder.Infrastructure.csproj" />
  </ItemGroup>
</Project>
