<UserControl x:Class="AndroidTvPcIsoBuilder.Presentation.Wpf.Views.DriverSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="640">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Pilotes Wi-Fi &amp; Bluetooth" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="Choisissez comment l'image générée prendra en charge le Wi-Fi et le Bluetooth de la machine cible."
                       FontSize="13" Foreground="{StaticResource Brush.TextSecondary}" />
        </StackPanel>

        <!-- Deux blocs côte à côte -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Bloc gauche : Pack de pilotes embarqué -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <CheckBox IsChecked="{Binding EmbeddedDriverPackEnabled}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="Pack de pilotes embarqué" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Modules noyau pré-compilés téléchargés et injectés dans l'image."
                                       FontSize="11.5" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="FABRICANTS DE CHIPSET" FontFamily="{StaticResource Font.Mono}"
                               FontSize="10.5" Foreground="{StaticResource Brush.TextDisabled}" />

                    <ItemsControl Grid.Row="4" ItemsSource="{Binding AvailableDrivers}"
                                  IsEnabled="{Binding EmbeddedDriverPackEnabled}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Margin="0,0,0,8" Padding="12" HorizontalContentAlignment="Left"
                                              HorizontalAlignment="Stretch"
                                              Command="{Binding DataContext.ToggleVendorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding VendorId}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceSunken}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                            <Setter Property="Padding" Value="12" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="IsChecked">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource CollectionContainsConverter}" Mode="OneWay">
                                                        <Binding Path="DataContext.SelectedVendorIds" RelativeSource="{RelativeSource AncestorType=ItemsControl}" Mode="OneWay" />
                                                        <Binding Path="VendorId" Mode="OneWay" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.AndroidAccent}" />
                                                    <Setter Property="Background" Value="{StaticResource Brush.AndroidAccentSoft}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Bloc droit : Détection automatique au boot -->
            <Border Grid.Column="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <CheckBox IsChecked="{Binding AutoDetectFirstBootEnabled}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="Détection automatique au boot" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Script exécuté au premier démarrage pour identifier et charger le bon module."
                                       FontSize="11.5" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="APERÇU DU SCRIPT (LECTURE SEULE, JAMAIS EXÉCUTÉ ICI)"
                               FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                               Foreground="{StaticResource Brush.TextDisabled}" />

                    <TextBox Grid.Row="4" Text="{Binding GeneratedScriptPreview, Mode=OneWay}"
                             FontFamily="{StaticResource Font.Mono}" FontSize="11" IsReadOnly="True"
                             TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <!-- Jauge de couverture -->
        <Border Grid.Row="4" Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel>
                <TextBlock Text="{Binding EstimatedCoveragePercent, StringFormat='Couverture estimée : {0:0}%'}"
                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding EstimatedCoveragePercent, Mode=OneWay}" Height="10" />
                <TextBlock Text="Le pack embarqué et la détection automatique sont complémentaires : activez les deux pour maximiser la compatibilité matérielle."
                           FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- Navigation -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Continuer → Compilation" Style="{StaticResource Style.Button.Primary}"
                    Padding="20,12" Command="{Binding NextCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
