<UserControl x:Class="AndroidTvPcIsoBuilder.Presentation.Wpf.Views.TargetSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="640">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Source ISO &amp; démarrage" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="Choisissez l'image Android TV déjà compilée à partir de laquelle générer votre ISO personnalisée."
                       FontSize="13" Foreground="{StaticResource Brush.TextSecondary}" />
        </StackPanel>

        <!-- Source ISO -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="SOURCE ISO ANDROID TV" FontFamily="{StaticResource Font.Mono}"
                       FontSize="10.5" Foreground="{StaticResource Brush.TextDisabled}" Margin="0,0,0,10" />
            <ListBox ItemsSource="{Binding AvailableSources}" SelectedItem="{Binding SelectedSource}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{StaticResource Brush.Surface}"
                                            BorderThickness="1.5" CornerRadius="10" Padding="16">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.AndroidAccent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource Brush.TextSecondary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Télécharger / Importer l'ISO..." Style="{StaticResource Style.Button.Primary}"
                        Padding="16,10" Margin="0,0,14,0" Command="{Binding OpenDownloadDialogCommand}" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Aucune ISO importée pour le moment." />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDownloadStepCompleted}" Value="True">
                                    <Setter Property="Text" Value="{Binding ImportedIsoLocalPath, StringFormat='ISO importée : {0}'}" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.AndroidAccent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Logo de démarrage (optionnel) -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="LOGO DE DÉMARRAGE (OPTIONNEL)" FontFamily="{StaticResource Font.Mono}"
                       FontSize="10.5" Foreground="{StaticResource Brush.TextDisabled}" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Parcourir..." Command="{Binding BrowseCustomLogoCommand}" Padding="14,9" Margin="0,0,12,0" />
                <TextBlock Text="{Binding CustomLogoPath}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Visibility="{Binding CustomLogoPath, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                <TextBlock Text="Logo par défaut" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource Brush.TextDisabled}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CustomLogoPath}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Navigation -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Continuer → Pilotes Wi-Fi/BT" Style="{StaticResource Style.Button.Primary}"
                    Padding="20,12" Command="{Binding NextCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
