<UserControl x:Class="AndroidTvPcIsoBuilder.Presentation.Wpf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="640">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Bloc central : titre + pitch + bouton -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="640">
            <TextBlock Text="PERSONNALISATION D'IMAGES ANDROID TV OFFICIELLES"
                       FontFamily="{StaticResource Font.Mono}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.AndroidAccent}" HorizontalAlignment="Center"
                       Margin="0,0,0,16" />

            <TextBlock Text="Construisez votre propre système Android TV" FontSize="30" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14" />

            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="14"
                       Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,30">
                À partir d'une image Android TV déjà compilée, piloté de bout en bout : matériel PC compatible (hors Mac),
                applications pré-installées, logo de démarrage personnalisé, image finale prête à graver.
            </TextBlock>

            <Button Content="Nouveau projet ISO" Style="{StaticResource Style.Button.Primary}"
                    HorizontalAlignment="Center" Padding="28,14" FontSize="14"
                    Command="{Binding StartCommand}" />
        </StackPanel>

        <!-- 3 étapes du parcours -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="ÉTAPE 01" FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                               Foreground="{StaticResource Brush.TextDisabled}" Margin="0,0,0,8" />
                    <TextBlock Text="Source ISO &amp; démarrage" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,6" />
                    <TextBlock Text="Choix de l'image Android TV officielle et du logo de démarrage animé."
                               FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="ÉTAPE 02" FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                               Foreground="{StaticResource Brush.TextDisabled}" Margin="0,0,0,8" />
                    <TextBlock Text="Applications" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,6" />
                    <TextBlock Text="Catalogue F-Droid ou APK glisser-déposer, embarqués dans l'image."
                               FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="ÉTAPE 03" FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                               Foreground="{StaticResource Brush.TextDisabled}" Margin="0,0,0,8" />
                    <TextBlock Text="Compilation en direct" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,6" />
                    <TextBlock Text="Visualisation temps réel : l'image Android TV se construit sous vos yeux."
                               FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
