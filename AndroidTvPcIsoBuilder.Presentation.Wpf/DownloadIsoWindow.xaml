<Window x:Class="AndroidTvPcIsoBuilder.Presentation.Wpf.DownloadIsoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:AndroidTvPcIsoBuilder.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Télécharger une image ISO" Height="460" Width="580" Icon="Assets/app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Background}"
        d:DataContext="{d:DesignInstance Type=vm:DownloadIsoViewModel}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Brush.MarkGradient}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Margin="0,0,12,0">
                <Path Data="M12 3 L12 15 M8 11 L12 15 L16 11 M4 21 L20 21" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.7"
                      Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Télécharger une image Android TV" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="Une image ISO officielle, prête à servir de base à un projet"
                           Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Label Content="Source" />
            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                      IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding SelectedSource.Description}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <Label Content="Enregistrer sous" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Parcourir..." Command="{Binding BrowseDestinationCommand}"
                        IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="8,0,0,0" />
                <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True" />
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="6" VerticalAlignment="Bottom">
            <Border Background="{StaticResource Brush.SurfaceSunken}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,18"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent, Mode=OneWay}" Height="8" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding DownloadStatus}" Foreground="{StaticResource Brush.TextSecondary}"
                               FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Command="{Binding CancelDownloadCommand}"
                        Style="{StaticResource Style.Button.Danger}"
                        IsEnabled="{Binding IsDownloading}" Margin="0,0,8,0" Padding="18,9" />
                <Button Command="{Binding StartDownloadCommand}"
                        Style="{StaticResource Style.Button.Primary}"
                        IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="18,9">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12 3 L12 15 M8 11 L12 15 L16 11 M4 21 L20 21" Stroke="#0C1220" StrokeThickness="1.7"
                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Télécharger" Foreground="#0C1220" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
