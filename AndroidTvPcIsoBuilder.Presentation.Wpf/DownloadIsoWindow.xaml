<Window x:Class="AndroidTvPcIsoBuilder.Presentation.Wpf.DownloadIsoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:AndroidTvPcIsoBuilder.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Télécharger une image ISO" Height="500" Width="580" Icon="Assets/app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Background}"
        d:DataContext="{d:DesignInstance Type=vm:DownloadIsoViewModel}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Brush.MarkGradient}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Margin="0,0,12,0">
                <Path Data="M12 3 L12 15 M8 11 L12 15 L16 11 M4 21 L20 21" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.7"
                      Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Télécharger une image Android TV" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="Le téléchargement se fait via votre navigateur, puis vous importez le fichier ici"
                           Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Label Content="Source" />
            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding SelectedSource.Description}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <Border Background="{StaticResource Brush.SurfaceSunken}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="9" Padding="18">
                <StackPanel>
                    <TextBlock Text="1. Ouvrez la page de téléchargement dans votre navigateur, et enregistrez le fichier."
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Button Content="Ouvrir la page de téléchargement" Command="{Binding OpenDownloadPageCommand}"
                            HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,16" />

                    <TextBlock Text="2. Une fois le téléchargement terminé, importez le fichier ici (si c'est une archive .zip, extrayez d'abord l'ISO qu'elle contient)."
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Button Content="Importer le fichier téléchargé" Command="{Binding ImportDownloadedFileCommand}"
                            Style="{StaticResource Style.Button.Primary}" HorizontalAlignment="Left" Padding="14,8">
                        <Button.Foreground>
                            <SolidColorBrush Color="#0C1220" />
                        </Button.Foreground>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="6" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding DestinationPath}" TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}"
                       FontSize="12" Foreground="{StaticResource Brush.TextSecondary}"
                       Visibility="{Binding CompletedSuccessfully, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="0,0,0,12" />
        </StackPanel>
    </Grid>
</Window>
