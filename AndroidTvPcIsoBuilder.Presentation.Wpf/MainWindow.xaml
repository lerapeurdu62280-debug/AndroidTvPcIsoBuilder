<Window x:Class="AndroidTvPcIsoBuilder.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AndroidTvPcIsoBuilder.Presentation.Wpf"
        xmlns:vm="clr-namespace:AndroidTvPcIsoBuilder.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Android TV PC ISO Builder" Height="700" Width="1120" MinHeight="580" MinWidth="880"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Background="{StaticResource Brush.Background}">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Assets/background.jpg" Stretch="UniformToFill" />
        </Grid.Background>

        <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource Brush.MarkGradient}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Margin="0,0,14,0">
                <Path Data="M4 6 L20 6 A2 2 0 0 1 22 8 L22 16 A2 2 0 0 1 20 18 L4 18 A2 2 0 0 1 2 16 L2 8 A2 2 0 0 1 4 6 Z M9 21 L17 21 M13 18 L13 21"
                      Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.6"
                      Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Android TV PC ISO Builder" FontSize="17" FontWeight="Bold" />
                <TextBlock Text="Créez une image ISO Android TV personnalisée, prête à démarrer sur PC"
                           Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Colonne gauche : liste des projets -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PROJETS" FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource Brush.TextDisabled}" Margin="4,2,0,10" />

                    <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Rechercher un projet..." Margin="0,0,0,10">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource Brush.SurfaceSunken}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Command="{Binding CreateProjectCommand}"
                                Style="{StaticResource Style.Button.Primary}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 5 L12 19 M5 12 L19 12" Stroke="#0C1220" StrokeThickness="2"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Nouveau projet" Foreground="#0C1220" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DownloadIsoCommand}"
                                Style="{StaticResource Style.Button.Ghost}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 3 L12 15 M8 11 L12 15 L16 11 M4 21 L20 21" Stroke="{StaticResource Brush.TextPrimary}" StrokeThickness="1.6"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Télécharger une image" />
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Importer..." Command="{Binding ImportProjectCommand}"
                                    Style="{StaticResource Style.Button.Ghost}" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="2" Content="Exporter..." Command="{Binding ExportProjectCommand}"
                                    Style="{StaticResource Style.Button.Ghost}" HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding SelectedProject, Converter={StaticResource NullToBooleanConverter}}" />
                        </Grid>
                        <Button Content="Supprimer le projet" Command="{Binding DeleteProjectCommand}"
                                Style="{StaticResource Style.Button.Danger}" HorizontalAlignment="Stretch"
                                IsEnabled="{Binding SelectedProject, Converter={StaticResource NullToBooleanConverter}}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Projects}"
                             SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectSummary}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.TextDisabled}"
                                             VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{Binding BaseSystem}" FontSize="11"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Colonne droite : édition du projet sélectionné -->
            <Border Grid.Column="2" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <!-- État vide : aucun projet sélectionné -->
                    <TextBlock Text="Sélectionnez ou créez un projet pour commencer"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentEditor}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ContentControl Content="{Binding CurrentEditor}">
                    <ContentControl.Resources>

                        <DataTemplate DataType="{x:Type vm:ProjectEditorViewModel}">
                            <TabControl Margin="10,0,10,10" Padding="0">
                                <TabControl.Resources>
                                    <Style TargetType="{x:Type TabPanel}">
                                        <Setter Property="Margin" Value="8,10,8,0" />
                                    </Style>
                                </TabControl.Resources>
                                <!-- Onglet Paramètres -->
                                <TabItem Header="PARAMÈTRES">
                                    <StackPanel Margin="18">
                                        <Label Content="Nom du projet" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                                        <Label Content="Image ISO source (assemblage)" />
                                        <DockPanel Margin="0,0,0,16">
                                            <Button DockPanel.Dock="Right" Content="Parcourir..." Command="{Binding BrowseSourceIsoPathCommand}" Margin="8,0,0,0" />
                                            <TextBox Text="{Binding SourceIsoPath, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>

                                        <Label Content="Fichier ISO de sortie" />
                                        <DockPanel Margin="0,0,0,16">
                                            <Button DockPanel.Dock="Right" Content="Parcourir..." Command="{Binding BrowseOutputIsoPathCommand}" Margin="8,0,0,0" />
                                            <TextBox Text="{Binding OutputIsoPath, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>

                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <Label Content="Version Android TV" />
                                                <ComboBox ItemsSource="{Binding AndroidVersionOptions}" SelectedItem="{Binding AndroidVersion}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <Label Content="Mode de démarrage" />
                                                <ComboBox ItemsSource="{Binding BootModeOptions}" SelectedItem="{Binding BootMode}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <Label Content="Résolution" />
                                                <TextBox Text="{Binding Resolution, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <Label Content="Langue" />
                                                <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="Enregistrer les paramètres" Command="{Binding SaveCommand}"
                                                Style="{StaticResource Style.Button.Primary}" HorizontalAlignment="Left" Padding="18,9" />
                                    </StackPanel>
                                </TabItem>

                                <!-- Onglet Applications -->
                                <TabItem Header="APPLICATIONS">
                                    <DockPanel Margin="18">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                                            <Button Content="+ Ajouter un APK..." Command="{Binding AddAppCommand}"
                                                    Style="{StaticResource Style.Button.Primary}" Margin="0,0,8,0" />
                                            <Button Content="Depuis le catalogue..." Command="{Binding AddAppFromCatalogCommand}"
                                                    Margin="0,0,8,0" />
                                            <Button Content="Retirer la sélection" Command="{Binding RemoveAppCommand}"
                                                    CommandParameter="{Binding SelectedItem, ElementName=AppsList}"
                                                    Style="{StaticResource Style.Button.Danger}" />
                                        </StackPanel>

                                        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"
                                                AllowDrop="True" Drop="AppsDropZone_Drop" DragOver="AppsDropZone_DragOver">
                                            <Grid>
                                                <ListView x:Name="AppsList" ItemsSource="{Binding Apps}" BorderThickness="0">
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="Nom" DisplayMemberBinding="{Binding Name}" Width="220" />
                                                            <GridViewColumn Header="Chemin APK" DisplayMemberBinding="{Binding SourceApkPath}" Width="380" />
                                                            <GridViewColumn Header="Préinstallée" DisplayMemberBinding="{Binding IsPreinstalled}" Width="110" />
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                                <TextBlock Text="Glissez-déposez des fichiers .apk ici pour les ajouter"
                                                           Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Apps.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DockPanel>
                                </TabItem>

                                <!-- Onglet Génération -->
                                <TabItem Header="GÉNÉRATION">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="18">
                                            <Border Background="{StaticResource Brush.SurfaceSunken}" BorderBrush="{StaticResource Brush.Border}"
                                                    BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,0,0,16"
                                                    Visibility="{Binding PreviewSummary, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                                                <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" FontSize="12"
                                                           FontFamily="{StaticResource Font.Mono}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPreviewWarnings}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                                <Button Content="Générer l'ISO" Command="{Binding BuildCommand}"
                                                        Style="{StaticResource Style.Button.Primary}"
                                                        IsEnabled="{Binding IsBuilding, Converter={StaticResource InverseBooleanConverter}}"
                                                        Padding="20,10" Margin="0,0,8,0" />
                                                <Button Content="Annuler" Command="{Binding CancelBuildCommand}"
                                                        Style="{StaticResource Style.Button.Danger}"
                                                        IsEnabled="{Binding IsBuilding}" Padding="20,10" />
                                            </StackPanel>

                                            <Border Background="{StaticResource Brush.SurfaceSunken}" BorderBrush="{StaticResource Brush.Border}"
                                                    BorderThickness="1" CornerRadius="9" Padding="20" Margin="0,0,0,20">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,12">
                                                        <TextBlock Text="{Binding BuildStep}" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Left" />
                                                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="13" Foreground="{StaticResource Brush.Accent}"
                                                                   HorizontalAlignment="Right">
                                                            <Run Text="{Binding BuildPercent, Mode=OneWay}" /><Run Text="%" />
                                                        </TextBlock>
                                                    </Grid>
                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding BuildPercent, Mode=OneWay}" Height="8" />
                                                    <TextBlock Text="{Binding BuildMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                                                               Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="HISTORIQUE" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{StaticResource Brush.TextDisabled}" Margin="2,0,0,10" />
                                            <ItemsControl ItemsSource="{Binding BuildHistory}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource Brush.SurfaceSunken}" BorderBrush="{StaticResource Brush.Border}"
                                                                BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,6">
                                                            <DockPanel>
                                                                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,3,10,0" VerticalAlignment="Top">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                                                                    <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Timestamp, StringFormat='dd/MM/yyyy HH:mm'}"
                                                                               FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                                                               Foreground="{StaticResource Brush.TextSecondary}" />
                                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12.5" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </DataTemplate>
                    </ContentControl.Resources>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
