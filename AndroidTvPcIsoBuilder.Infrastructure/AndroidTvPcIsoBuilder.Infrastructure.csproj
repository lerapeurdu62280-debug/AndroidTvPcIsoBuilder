<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows + UseWPF : requis par BootAnimationGenerator, qui s'appuie sur
         System.Windows.Media.Imaging (DrawingVisual/RenderTargetBitmap/PngBitmapEncoder)
         pour dessiner et encoder les frames du bootanimation.zip sans ajouter de dépendance
         NuGet lourde (ex. System.Drawing.Common). L'ensemble du projet étant déjà
         Windows-only (application WPF), ce ciblage
         n'introduit pas de nouvelle contrainte de portabilité. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Le profil ImplicitUsings du SDK change avec UseWPF=true (il n'inclut alors plus
       System.IO ni System.Net.Http, contrairement au profil "console" utilisé avant le
       passage à net10.0-windows). On les restaure explicitement pour ne rien casser dans
       le code existant qui compte sur ces usings implicites. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LTRData.DiscUtils.Core" Version="1.0.87" />
    <PackageReference Include="LTRData.DiscUtils.Iso9660" Version="1.0.87" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AndroidTvPcIsoBuilder.Application\AndroidTvPcIsoBuilder.Application.csproj" />
    <ProjectReference Include="..\AndroidTvPcIsoBuilder.Domain\AndroidTvPcIsoBuilder.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Script de démarrage déposé dans /scripts de l'ISO (voir IsoBuilder) : embarqué comme ressource
         pour être lu à l'exécution sans dépendre d'un chemin de fichier sur le disque de sortie.
         WithCulture="false" et LogicalName explicite sont nécessaires car MSBuild interprète sinon
         l'extension ".sh" du nom de fichier comme un code de culture (le Sindhi, "sh") et embarque
         le fichier dans un assembly satellite au lieu de l'assembly principal. -->
    <EmbeddedResource Include="Assets\Scripts\atvbuilder-boot.sh" WithCulture="false"
                       LogicalName="AndroidTvPcIsoBuilder.Infrastructure.Assets.Scripts.atvbuilder-boot.sh" />
  </ItemGroup>

</Project>
